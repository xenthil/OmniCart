# Copy this file to ".env" (same folder as docker-compose.yml) and fill in real values.
# .env is gitignored — never commit actual secrets.

# Must satisfy SQL Server's password complexity policy:
# 8+ chars, at least 3 of: uppercase, lowercase, digit, symbol.
SA_PASSWORD=YourStrong!Passw0rd

# Any long random string works for local/QA. Use a proper secrets manager in production.
JWT_KEY=ReplaceThisWithARandomSecureStringAtLeast32CharsLong
